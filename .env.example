# Payment behavior modes:
# off    -> website works normally
# remind -> all pages show flashing payment due alert
# on     -> all routes redirect to /maintenance
NEXT_PUBLIC_PAYMENT=off

# Flashing reminder message (used when mode=remind)
NEXT_PUBLIC_PAYMENT_REMINDER_MESSAGE=PAYMENT DUE: Please clear pending bill to avoid website suspension.

# Maintenance message (used when mode=on)
NEXT_PUBLIC_PAYMENT_MAINTENANCE_MESSAGE=Website is in maintenance due to pending bill.

# Contact details shown on maintenance page and reminder
NEXT_PUBLIC_PAYMENT_SUPPORT_NAME=Vwebstudio
NEXT_PUBLIC_PAYMENT_SUPPORT_PHONE=8985221344
